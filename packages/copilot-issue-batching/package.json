{
  "name": "@averlon/copilot-issue-batching",
  "version": "1.0.0",
  "description": "Generic batching and state-in-body sync for GitHub issues (Copilot workflows)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "build": "bun run --bun tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\""
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@averlon/github-actions-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
